# fd --ignore-file, gitignore format. Used ONLY by context's `files` and
# `search` pickers (context/producers.py), paired with --no-ignore-vcs --
# so a repo's own .gitignore no longer hides anything from the picker, and
# this file is the only thing that does. Edit freely.

node_modules/
.git/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
target/
.next/
.nuxt/
.turbo/
.cache/
coverage/
.terraform/

# The home folder is the search scope for workspaces with no folder (work, personal, ...).
# Anchored, so a project's own Library/ (Unity and the like) is not hidden by this line.
# ~/Library alone is 700,000 of the home folder's 760,000 files (measured 2026-11-07).
/Library/
