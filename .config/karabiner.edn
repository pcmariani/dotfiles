; https://github.com/gabriel-gardner/modtap-karabiner/blob/main/modtap_example.edn
; https://github.com/gabriel-gardner/modtap-karabiner/blob/main/another_example_karabiner.edn
; https://github.com/yqrashawn/GokuRakuJoudo/blob/master/resources/configurations/edn/example.edn
; https://gist.github.com/gsinclair/f4ab34da53034374eb6164698a0a8ace

{

 :profiles {
            :Default {
                      :default true

                      ; simultaneous_threshold_milliseconds (def: 50)
                      ; different from simlayers, this is for cases like [:a :b]
                      :sim     50

                      ; to_delayed_action_delay_milliseconds (def: 500)
                      ; note: this should be equal to :held for mod-tap layers
                      :delay   160

                      ; to_if_held_down_threshold_milliseconds (def: 500)
                      ; note: this should be equal to :delay for mod-tap layers
                      :held    160

                      ; to_if_alone_timeout_milliseconds (def: 1000)
                      ; note: (i think) this must be just less than the delay / held value to avoid bug where mod-tap layer stays 1
                      :alone   159

                      ; you can set these delays individually in mod-tap layer definitions if you want separate default values here 
                      }
            }

 :templates {
             :open "open -a \"%s\""
             :open-args "open -a \"%s\""
             :openg "open -g \"%s\""
             :link "osascript -e 'do shell script \"open %s\"'"
             ;; :shell wraps the command in osascript, which costs ~106ms per press.
             ;; Prefer :run, which emits the shell_command directly. Note that
             ;; :run has no login shell, so use absolute paths — `~` will not
             ;; expand and Homebrew is not on PATH.
             :shell "osascript -e 'do shell script \"%s\"'"
             ;; Direct: no osascript wrapper. Measured at ~106ms of pure
             ;; overhead per invocation, which is the largest single cost in
             ;; the picker's launch path.
             :run "%s"
             :aerospace "/opt/homebrew/bin/aerospace %s"
             ;; Absolute path for the same reason as :run above — a hotkey gets
             ;; PATH=/usr/bin:/bin:/usr/sbin:/sbin, where python3 is 3.9 and has
             ;; no tomllib. bin/context re-execs the right interpreter itself.
             :context "/Users/petermariani/projects/context-based-mac/bin/context %s"
             }

 ;; define application identifiers
 :applications {
                :chrome ["^com\\.google\\.Chrome$"]
                :chrome-canary [ "^com\\.google\\.Chrome\\.canary$"]
                :chromes ["^com\\.google\\.Chrome$" "^com\\.google\\.Chrome\\.canary$"]
                }

 :main [

        {
         :des "CAPSLOCK is CTRL if pressed in combination, otherwise ESC"
         :rules  [[:##caps_lock :left_control nil {:alone :escape}]]
         }

        ; Placed before the mod-tap layers so ctrl-space is claimed here rather
        ; than falling through to the plain-spacebar space-mode trigger. Since
        ; caps_lock is already left_control (rule above), this is caps+space:
        ; one chord rather than a mode-hold, which matters for the key that
        ; gets pressed most.
        ;
        ; Emits F18 rather than shelling out. Hammerspoon binds F18 and shows
        ; the picker in-process, which skips the `hs -c` round trip — that
        ; round trip measured 60-70ms of the ~130ms total, because it waits for
        ; the runloop and the panel activation. F18 is unused by macOS and by
        ; anything else here. The rule still claims ctrl-space exactly as it
        ; did, so the ordering comment above still holds.
        ;
        ; bin/context-pick remains the terminal entry point and the fallback
        ; for when Hammerspoon is not running.
        {
         :des "context picker"
         :rules [[:!Tspacebar :f18]]
         }

        ; note: When adding a new layer, if you want it to be able to cross with an old one, you must add the name negated (:!new_name) to all other mod-tap layer conditions
        {
         :des "mod-tap layers"
         :rules [
                 ;chrome mode
                 [:a nil [:!d-mode :!s-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :a :halt true} :delayed {:canceled {:key :a}} :held {:set ["a-mode" 1] :repeat false} :afterup {:set ["a-mode" 0]}
                   ;:params {:alone 199 :held 200 :delay 200} 
                   }]

                 ;special-characters-mode
                 [:s nil [:!a-mode :!d-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :s :halt true} 
                   :delayed {:canceled {:key :s}} 
                   :held {:set ["s-mode" 1] :repeat false} 
                   :afterup {:set ["s-mode" 0]}}]

                 ;digits-mode
                 [:d nil [:!a-mode :!s-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :d :halt true} 
                   :delayed {:canceled {:key :d}} 
                   :held {:set ["d-mode" 1] :repeat false} 
                   :afterup {:set ["d-mode" 0]}}]

                 ;vim-mode
                 [:v nil [:!a-mode :!d-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :v :halt true} 
                   :delayed {:canceled {:key :v}} 
                   :held {:set ["v-mode" 1] :repeat false} 
                   :afterup {:set ["v-mode" 0]}}]

                 ;space-mode
                 [:spacebar nil [:!a-mode :!d-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :spacebar :halt true} 
                   :delayed {:canceled {:key :spacebar}} 
                   :held {:set ["space-mode" 1] :repeat false} 
                   :afterup {:set ["space-mode" 0]}}]

                 ;cmd-space-mode
                 ; note: :modi re-emits the command so a tap still reaches
                 ; Spotlight. Beware :modifiers, which goku silently drops.
                 [:!Cspacebar nil [:!a-mode :!d-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :spacebar :modi :left_command :halt true}
                   :delayed {:canceled {:key :spacebar :modi :left_command}}
                   :held {:set ["cmd-space-mode" 1] :repeat false}
                   :afterup {:set ["cmd-space-mode" 0]}}]
                 ]
         }

        {
         :des "space-mode: AeroSpace commands"
         :rules [
                 :space-mode

                 ;; commands
                 [:m :!!m] ;; hammerspoon hyper M: toggle mute mic
                 [:!Sr :!!r] ;; hammerspoon hyper R: reload hammerspoon

                 ;; applications
                 [:g :!!g] ;; hammerspoon hyper G: focus chrome Boomi Gmail
                 [:i [:open "Messages"]]
                 [:s [:open "Slack"]]
                 ; [:q [:open "finder"]]
                 ; [:e [:open "Spotify"]]
                 [:t [:!!t]] ;; ghostty quick terminal (hyper-T)

                 ;; Ambient workspaces. These hold singleton apps — Slack,
                 ;; Messages, Mail — which cannot be partitioned per project,
                 ;; plus the unfiled-but-persistent browser and AI windows.
                 ;; Previous workspace. Moved off plain tab 2026-09-01 when tab
                 ;; became the in-workspace window cycler; shift-tab keeps the
                 ;; one-key jump rather than losing it.
                 [:!Stab [:aerospace "workspace-back-and-forth"]]

                 [:w [:aerospace "workspace work"]]
                 [:a [:aerospace "workspace ai"]]
                 [:b [:aerospace "workspace browser"]]
                 [:p [:aerospace "workspace personal"]]

                 ;; 1-9 are deliberately unbound. Numbered context slots were
                 ;; tried and removed 2026-08-31: pinning a number to a name
                 ;; needs a config edit to renumber, and the picker's fuzzy
                 ;; match (ctrl-space, "apo", enter) is close enough in
                 ;; keystrokes to not warrant a second mechanism.

                 ;; AeroSpace - windows
                 ;; Cycle the windows of this workspace. dfs-next walks the
                 ;; layout tree, so it reaches every window regardless of how
                 ;; the splits are nested; --wrap-around makes the last one
                 ;; return to the first instead of stopping.
                 [:tab [:aerospace "focus dfs-next --wrap-around"]]

                 ;; j/k cross the monitor boundary; h/l deliberately do not.
                 ;; The monitors are stacked vertically (1 = LG HDR WQHD above
                 ;; 2 = Built-in Retina), so only up/down ever needs to leave
                 ;; the workspace. Putting the flag on h/l too would let a
                 ;; horizontal press jump monitors anywhere the frames overlap
                 ;; sideways -- a surprise that is hard to attribute later.
                 ;;
                 ;; The action is `stop`, not `wrap-around-all-monitors`:
                 ;; pressing j at the bottom of monitor 2 should do nothing,
                 ;; not teleport to the top of monitor 1.
                 [:h [:aerospace "focus left"]]
                 [:j [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop down"]]
                 [:k [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop up"]]
                 [:l [:aerospace "focus right"]]

                 [:hyphen [:aerospace "resize smart -200"]]
                 [:equal_sign [:aerospace "resize smart +200"]]

                 ;; AeroSpace - window state
                 [:f [:aerospace "fullscreen"]]
                 [:z [:aerospace "layout floating tiling"]]
                 [:r [:aerospace "flatten-workspace-tree"]] ;; reset the layout tree

                 ;; AeroSpace - layout
                 [:comma [:run "/Users/petermariani/.config/aerospace/set-layout.sh accordion"]]
                 [:period [:run "/Users/petermariani/.config/aerospace/set-layout.sh tiles"]]

                 ;; AeroSpace - monitor
                 [:grave_accent_and_tilde [:aerospace "move-workspace-to-monitor --wrap-around next"]]

                 ;; AeroSpace - new intance
                 ;; Ghostty moved off shift-T 2026-09-01 to free that key for
                 ;; the coming tab picker. space-enter reads well for "open a
                 ;; terminal here" and was unbound.
                 [:!Sb [:run "/Users/petermariani/.config/aerospace/new-chrome.sh"]]
                 [:return_or_enter [:run "/Users/petermariani/.config/aerospace/new-ghostty.sh"]]

                 ;; context - pin the live Chrome tabs of the context you are
                 ;; standing in. No name argument on purpose: the focused
                 ;; workspace IS the context, which is the whole point of a key.
                 ;;
                 ;; --add rather than the default replace. `pin` replaces, and a
                 ;; key is easy to fumble: pressing this with only a New Tab
                 ;; open would swap a curated set for chrome://newtab/. The
                 ;; empty-set guard does not catch that, because one tab is not
                 ;; zero tabs. --add cannot lose anything.
                 ;;
                 ;; --notify because Karabiner discards stdout and the exit
                 ;; status, so without it a successful pin is indistinguishable
                 ;; from the key never firing.
                 [:!Sp [:context "--notify pin --add"]]

                 ]

         }

        {
         :des "cmd-space-mode"
         :rules [
                 :cmd-space-mode

                 [:##w [:aerospace "move-node-to-workspace work"]]
                 [:##a [:aerospace "move-node-to-workspace ai"]]
                 [:##b [:aerospace "move-node-to-workspace browser"]]
                 [:##p [:aerospace "move-node-to-workspace personal"]]

                 ;; 1-9 unbound alongside space-mode. Sending a window to a
                 ;; project context has no binding for now; a move-mode picker
                 ;; is the intended home for it if the need proves real.

                 [:##h [:aerospace "move left"]]
                 [:##j [:aerospace "move down"]]
                 [:##k [:aerospace "move up"]]
                 [:##l [:aerospace "move right"]]

                 ]
         }

        {
         :des "chrome-mode"
         :rules [
                 :a-mode
                 [:m "open -a arc-alert.sh.app --args '(function () { alert(\"hello\"); }())'"]
                 [:n "open -a arc-focus-tab.sh.app --args 'Gmail'"]
                 [:l "pbpaste | tr '[:upper:]' '[:lower:]' | pbcopy"]
                 ]
         }

        { 
         :des "d-mode"
         :rules [
                 :d-mode
                 [:m :1]
                 [:comma, :2]
                 [:period, :3]
                 [:j :4]
                 [:k :5]
                 [:l :6]
                 [:u :7]
                 [:i :8]
                 [:o :9]
                 [:right_command :0]
                 [:spacebar :0]
                 ]
         }

        {
         :des "s-mode"
         :rules [
                 :s-mode
                 [:##u :!S9]
                 [:##i :!S0]
                 [:##o :!S1]

                 [:##j :!Sopen_bracket]
                 [:##k :!Sclose_bracket]
                 [:##l :!Sslash]

                 [:##m :open_bracket]
                 [:##comma :close_bracket]
                 [:##period :!S4]

                 ; [:j :!Sopen_bracket]
                 ; [:k :!Sclose_bracket]
                 ; [:h :open_bracket]
                 ; [:l :close_bracket]
                 ; [:u :!S9]
                 ; [:i :!S0]
                 ]
         }

        {
         :des "vim-mode"
         :rules [
                 :v-mode
                 [:h :left_arrow]
                 [:j :down_arrow]
                 [:k :up_arrow]
                 [:l :right_arrow]
                 ]
         }

        ]
 }


; TOs
;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; P  | caps_lock
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any

; RULES
;; [<from> <to>] or
;; [<from> <to> <conditions>] or
;; [<from> <to> <conditions> <other options>]
;; <from> can be keywords defined in froms or keycodes without `{:not-from true}`
;; <to> can be keywords defined in tos, keycodes without `{:not-to true}`, string (shell script)
;; <conditions> can be keywords defined in layers, devices, applications
;; <other options> {:other {:parameters {:to_delayed_action_delay_milliseconds 100 :basic.to_if_alone_timeout_milliseconds 500 :basic.to_if_held_down_threshold_milliseconds 250}} }

