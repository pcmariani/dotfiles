; https://github.com/gabriel-gardner/modtap-karabiner/blob/main/modtap_example.edn
; https://github.com/gabriel-gardner/modtap-karabiner/blob/main/another_example_karabiner.edn
; https://github.com/yqrashawn/GokuRakuJoudo/blob/master/resources/configurations/edn/example.edn
; https://gist.github.com/gsinclair/f4ab34da53034374eb6164698a0a8ace

{

 :profiles {
            :Default {
                      :default true

                      ; simultaneous_threshold_milliseconds (def: 50)
                      ; different from simlayers, this is for cases like [:a :b]
                      :sim     50

                      ; to_delayed_action_delay_milliseconds (def: 500)
                      ; note: this should be equal to :held for mod-tap layers
                      :delay   160

                      ; to_if_held_down_threshold_milliseconds (def: 500)
                      ; note: this should be equal to :delay for mod-tap layers
                      :held    160

                      ; to_if_alone_timeout_milliseconds (def: 1000)
                      ; note: (i think) this must be just less than the delay / held value to avoid bug where mod-tap layer stays 1
                      :alone   159

                      ; you can set these delays individually in mod-tap layer definitions if you want separate default values here 
                      }
            }

 :templates {
             :open "open -a \"%s\""
             :open-args "open -a \"%s\""
             :openg "open -g \"%s\""
             :link "osascript -e 'do shell script \"open %s\"'"
             ;; :shell wraps the command in osascript, which costs ~106ms per press.
             ;; Prefer :run, which emits the shell_command directly. Note that
             ;; :run has no login shell, so use absolute paths — `~` will not
             ;; expand and Homebrew is not on PATH.
             :shell "osascript -e 'do shell script \"%s\"'"
             ;; Direct: no osascript wrapper. Measured at ~106ms of pure
             ;; overhead per invocation, which is the largest single cost in
             ;; the picker's launch path.
             :run "%s"
             :aerospace "/opt/homebrew/bin/aerospace %s"
             ;; Absolute path for the same reason as :run above — a hotkey gets
             ;; PATH=/usr/bin:/bin:/usr/sbin:/sbin, where python3 is 3.9 and has
             ;; no tomllib. bin/context re-execs the right interpreter itself.
             :context "/Users/petermariani/projects/context-based-mac/bin/context %s"
             }

 ;; define application identifiers
 :applications {
                :chrome ["^com\\.google\\.Chrome$"]
                :chrome-canary [ "^com\\.google\\.Chrome\\.canary$"]
                :chromes ["^com\\.google\\.Chrome$" "^com\\.google\\.Chrome\\.canary$"]
                ;; Apps that OWN ctrl-hjkl and must never have it taken away.
                ;; Ghostty holds herdr, whose own binding walks panes and then
                ;; hands off to AeroSpace; Neovide is nvim in its own window
                ;; and walks splits the same way. Anything NOT here has no
                ;; navigation of its own, which is what `:!terminals` below
                ;; keys on. Add a terminal here before using it, or ctrl-hjkl
                ;; will start moving windows out from under it.
                :terminals ["^com\\.mitchellh\\.ghostty$" "^com\\.neovide\\.neovide$"]
                }

 :main [

        {
         :des "CAPSLOCK is CTRL if pressed in combination, otherwise ESC"
         :rules  [[:##caps_lock :left_control nil {:alone :escape}]]
         }

        ;; THE WORKSPACE SWITCHER, 2026-09-10. cmd-tab switches AeroSpace
        ;; workspaces instead of apps: hold cmd, tap tab to cycle, release to
        ;; commit. Backup before this rule: karabiner.edn.bak-preswitcher
        ;;
        ;; Carbon CANNOT have cmd-tab. RegisterEventHotKey accepts it with
        ;; OSStatus 0 and then it fires ZERO times, because the Dock's app
        ;; switcher consumes it first -- measured 2026-09-09, and a reminder
        ;; that a successful registration is not evidence the chord works.
        ;; Karabiner sits below the Dock and can take it; the rewritten chord
        ;; then reaches paneld's Carbon registration, 9 fires out of 9.
        ;;
        ;; The `to` KEEPS cmd deliberately. Release-to-commit reads the
        ;; modifier through a local NSEvent monitor, which needs no
        ;; Accessibility grant because paneld's panel holds key. A bare f18
        ;; would drop the modifier and nothing would ever commit.
        ;;
        ;; `!C` is LEFT command in goku, so right-cmd-tab still reaches the
        ;; Dock. That is the escape hatch if this misbehaves.
        ;;
        ;; To revert: delete this rule (goku reapplies on save) and the
        ;; [[panel]] named `switcher` in ~/.config/paneld/paneld.toml, then
        ;;     launchctl kickstart -k "gui/$(id -u)/dev.paneld.paneld"
        {
         :des "workspace switcher: cmd-tab -> paneld"
         ;; `:!CStab`, NOT `:!C!Stab`. goku takes ONE `!` followed by all the
         ;; modifier letters -- the same shape as `:!Stab` and `:!Cspacebar`
         ;; elsewhere in this file. The two-bang form compiled without
         ;; complaint and silently did not match, so shift-cmd-tab reached
         ;; nothing. Found by hand 2026-09-10; the forward chord was correct
         ;; from the start, which is what made the difference visible.
         ;; THREE rules, not two. goku's `S` is LEFT shift and `R` is RIGHT
         ;; shift -- verified by reading the compiled karabiner.json, not
         ;; assumed. With cmd held by the left thumb, shift-tab is a natural
         ;; right-shift reach, and the left-only rule simply did not match:
         ;; the chord fell through to the Dock and opened the macOS app
         ;; switcher. That is the correct symptom for "no rule matched", and
         ;; it looks nothing like a paneld bug.
         ;;
         ;; Both map to the SAME cmd-shift-f18, because paneld parses
         ;; "cmd-shift-f18" into Carbon's generic shiftKey, which is
         ;; side-agnostic. Right COMMAND is deliberately not handled: the
         ;; forward chord works, which proves left cmd is the one in use.
         :rules [[:!Ctab  :!Cf18]
                 [:!CStab :!CSf18]
                 [:!CRtab :!CSf18]]
         }

        ;; CTRL-HJKL, THE OUTSIDE HALF, 2026-09-10. One key navigates
        ;; everywhere: nvim splits -> herdr panes -> macOS windows.
        ;;
        ;; The first two layers are handled INSIDE the terminal --
        ;; ~/.config/herdr/nav-fallthrough.sh, bound to ctrl-hjkl in
        ;; ~/.config/herdr/config.toml, and the `at_edge` hook in
        ;; ~/.config/nvim/plugin/herdr-splits-nvim.lua. Neither can help
        ;; anywhere else: they are herdr and nvim keybindings, so they only
        ;; exist while one of those has keyboard focus. That is why navigation
        ;; was ONE-WAY before this rule -- you could leave Ghostty for a Chrome
        ;; window and nothing could bring you back, because no part of the
        ;; system was listening for ctrl-hjkl in Chrome.
        ;;
        ;; `:!terminals` and not `:!chrome`: the rule must be off in every app
        ;; that owns these keys, and on in every app that does not. Inverting
        ;; that -- listing where it SHOULD fire -- would silently fail to
        ;; navigate in each new app until it was added.
        ;;
        ;; `:!T` is LEFT control, which is what CAPSLOCK emits (see the rule
        ;; above). Right control is deliberately unhandled, matching how the
        ;; switcher leaves right command to the Dock.
        ;;
        ;; `--boundaries-action fail` makes "no window that way" a silent
        ;; no-op instead of a wrap, so a direction key never sends you
        ;; backwards -- the same rule the other two layers follow.
        ;; j/k CROSS THE MONITOR BOUNDARY, h/l DELIBERATELY DO NOT, matching
        ;; space-hjkl below. Added 2026-09-11: the two disagreed, and the
        ;; symptom the user reported was "space-j focuses a window below even
        ;; if it is on another workspace on another monitor, but ctrl-j does
        ;; not". Directional `focus` defaults `--boundaries` to `workspace`, so
        ;; without the flag ctrl-j stops at the workspace edge. The monitors
        ;; are stacked vertically (1 = LG HDR WQHD above 2 = Built-in Retina),
        ;; so only up/down ever needs to leave the workspace -- putting the
        ;; flag on h/l too would let a sideways press jump monitors wherever
        ;; the frames overlap.
        ;;
        ;; THE SAME CHANGE IS NEEDED IN TWO MORE PLACES, because this rule is
        ;; off inside terminals: ~/.config/herdr/nav-fallthrough.sh and the
        ;; `at_edge` function in ~/.config/nvim/plugin/herdr-splits-nvim.lua.
        ;; All three must agree or ctrl-j behaves differently depending on
        ;; which app happens to hold focus.
        {
         :des "ctrl-hjkl navigates windows outside the terminal"
         :rules [[:!Th [:aerospace "focus --boundaries-action fail left"]  [:!terminals]]
                 [:!Tj [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action fail down"]  [:!terminals]]
                 [:!Tk [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action fail up"]    [:!terminals]]
                 [:!Tl [:aerospace "focus --boundaries-action fail right"] [:!terminals]]]
         }

        ; THE CONTEXT PICKER RULE IS GONE, 2026-09-05. Both halves of it are.
        ;
        ; ctrl-shift-space went first: it rewrote to hyper-P for the Ghostty
        ; instance's private global keybind, and Karabiner rewrites BELOW the
        ; layer Carbon registers against -- so paneld's registration succeeded
        ; and the chord never arrived.
        ;
        ; ctrl-space now goes STRAIGHT THROUGH to paneld, which registers it
        ; itself with Carbon's RegisterEventHotKey -- no rewrite here, no
        ; Hammerspoon, and no `hs -c` round trip to skip, because there is no
        ; hs.chooser left to call.
        ;
        ; Nothing below claims it: the mod-tap `:spacebar` rules carry no
        ; optional modifiers, so ctrl-space cannot fall into the space-mode
        ; layer or pay its 160ms `to_if_held_down_threshold`. Verified in the
        ; generated karabiner.json.
        ;
        ; IF ctrl-space DOES NOT REACH THE PANEL: macOS binds it to "select
        ; the previous input source" by default. It is disabled on this machine
        ; (symbolichotkeys 60 and 61, both enabled=0), but if something else
        ; claims it, put the old F18 hop back --
        ;
        ;   {:des "context picker" :rules [[:!Tspacebar :f18]]}
        ;
        ; -- and set `hotkey = "f18"` in ~/.config/paneld/paneld.toml. F18 is
        ; unused by macOS and by everything else here, which is why the
        ; chooser used it for months. `paneld toggle picker` works regardless.

        ; note: When adding a new layer, if you want it to be able to cross with an old one, you must add the name negated (:!new_name) to all other mod-tap layer conditions
        {
         :des "mod-tap layers"
         :rules [
                 ;chrome mode
                 [:a nil [:!d-mode :!f-mode :!s-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :a :halt true} :delayed {:canceled {:key :a}} :held {:set ["a-mode" 1] :repeat false} :afterup {:set ["a-mode" 0]}
                   ;:params {:alone 199 :held 200 :delay 200} 
                   }]

                 ;special-characters-mode
                 [:s nil [:!a-mode :!d-mode :!f-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :s :halt true} 
                   :delayed {:canceled {:key :s}} 
                   :held {:set ["s-mode" 1] :repeat false} 
                   :afterup {:set ["s-mode" 0]}}]

                 ;digits-mode
                 [:d nil [:!a-mode :!f-mode :!s-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :d :halt true} 
                   :delayed {:canceled {:key :d}} 
                   :held {:set ["d-mode" 1] :repeat false} 
                   :afterup {:set ["d-mode" 0]}}]

                 ;vim-mode
                 [:v nil [:!a-mode :!d-mode :!f-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :v :halt true} 
                   :delayed {:canceled {:key :v}} 
                   :held {:set ["v-mode" 1] :repeat false} 
                   :afterup {:set ["v-mode" 0]}}]

                 ;scroll-mode. `f` because it sits under the pointer finger and
                 ; is easy to hold. It is a HIGHER-FREQUENCY letter than the
                 ; other mod-tap keys and is doubled in ordinary words ("off",
                 ; "buffer"), so if it misfires while typing, the knob is the
                 ; commented-out `:params {:alone 199 :held 200 :delay 200}` in
                 ; chrome-mode above, not a different key.
                 [:f nil [:!a-mode :!d-mode :!s-mode :!v-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :f :halt true}
                   :delayed {:canceled {:key :f}}
                   :held {:set ["f-mode" 1] :repeat false}
                   :afterup {:set ["f-mode" 0]}}]

                 ;space-mode
                 [:spacebar nil [:!a-mode :!d-mode :!f-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :spacebar :halt true} 
                   :delayed {:canceled {:key :spacebar}} 
                   :held {:set ["space-mode" 1] :repeat false} 
                   :afterup {:set ["space-mode" 0]}}]

                 ;cmd-space-mode
                 ; note: :modi re-emits the command so a tap still reaches
                 ; Spotlight. Beware :modifiers, which goku silently drops.
                 [:!Cspacebar nil [:!a-mode :!d-mode :!f-mode :!s-mode :!space-mode :!cmd-space-mode]
                  {:alone {:key :spacebar :modi :left_command :halt true}
                   :delayed {:canceled {:key :spacebar :modi :left_command}}
                   :held {:set ["cmd-space-mode" 1] :repeat false}
                   :afterup {:set ["cmd-space-mode" 0]}}]
                 ]
         }

        {
         :des "space-mode: AeroSpace commands"
         :rules [
                 :space-mode

                 ;; commands
                 [:m :!!m] ;; hammerspoon hyper M: toggle mute mic
                 [:!Sr :!!r] ;; hammerspoon hyper R: reload hammerspoon
                 ;; Break the active Chrome tab into its own window, so it can
                 ;; then be moved to a workspace like any other window. Silent
                 ;; no-op unless Chrome is frontmost with 2+ tabs -- Chrome's
                 ;; own menu item reports whether there is anything to do.
                 [:d :!!d] ;; hammerspoon hyper D: detach chrome tab to a window
                 ;; Same, then immediately open the move picker so the new
                 ;; window can be placed -- the two-key flow as one key.
                 ;;
                 ;; Sends hyper MINUS shift, not hyper-shift-D, because hyper
                 ;; already CONTAINS shift: hyper-D and hyper-shift-D are the
                 ;; same chord and Hammerspoon cannot tell them apart. Dropping
                 ;; shift keeps this in the `d` family while staying distinct.
                 [:!Sd :!CTOd] ;; hammerspoon cmd-ctrl-alt D: detach and move

                 ;; applications
                 [:g :!!g] ;; hammerspoon hyper G: focus chrome Boomi Gmail
                 [:i [:open "Messages"]]
                 [:s [:open "Slack"]]
                 ; [:q [:open "finder"]]
                 ; [:e [:open "Spotify"]]
                 ;; THE WORKSPACE TERMINAL. `context terminal` attaches this
                 ;; workspace's herdr session -- creating it if there is none --
                 ;; in a Ghostty window rooted at the workspace directory. It is
                 ;; a no-op if the workspace already has a terminal.
                 ;;
                 ;; This is the second half of the two-keystroke flow: ctrl-space
                 ;; picks a workspace and `enter` only FOCUSES it (2026-09-08,
                 ;; the subtraction), so something has to ask for the terminal.
                 ;;
                 ;; Takes no workspace name, deliberately: AeroSpace places a new
                 ;; window by focus, so the verb can only act correctly on the
                 ;; workspace you are already in. That is why this is a key you
                 ;; press after arriving rather than an action on a picker row.
                 ;;
                 ;; Uses :context, not :shell -- the osascript wrapper costs
                 ;; ~106ms. A failure notifies on its own (main() notifies
                 ;; unconditionally on a non-zero exit), so pressing this in an
                 ;; ambient workspace says so instead of doing nothing visible.
                 [:t [:context "terminal"]]
                 ; [:!St [:open "Ghostty"]]

                 ;; Ghostty's quick terminal, moved off space-t 2026-09-09 to
                 ;; make room for the above. Ghostty's own config is unchanged:
                 ;; it listens for hyper-T (global:shift+cmd+ctrl+alt+t), and
                 ;; hyper-T is still what gets sent -- just from a different
                 ;; chord. Unfiled terminal use is ephemeral, which is why it
                 ;; stays a dropdown rather than becoming a workspace.
                 [:!St [:!!t]] ;; ghostty quick terminal (hyper-T)

                 ;; Ambient workspaces. These hold singleton apps — Slack,
                 ;; Messages, Mail — which cannot be partitioned per project,
                 ;; plus the unfiled-but-persistent browser and AI windows.
                 ;; Previous workspace. Moved off plain tab 2026-09-01 when tab
                 ;; became the in-workspace window cycler; shift-tab keeps the
                 ;; one-key jump rather than losing it.
                 [:!Stab [:aerospace "workspace-back-and-forth"]]

                 [:w [:aerospace "workspace work"]]
                 [:a [:aerospace "workspace ai"]]
                 [:b [:aerospace "workspace browser"]]
                 [:p [:aerospace "workspace personal"]]

                 ;; 1-9 are deliberately unbound. Numbered context slots were
                 ;; tried and removed 2026-08-31: pinning a number to a name
                 ;; needs a config edit to renumber, and the picker's fuzzy
                 ;; match (ctrl-space, "apo", enter) is close enough in
                 ;; keystrokes to not warrant a second mechanism.

                 ;; AeroSpace - windows
                 ;; Cycle the windows of this workspace. dfs-next walks the
                 ;; layout tree, so it reaches every window regardless of how
                 ;; the splits are nested.
                 ;;
                 ;; BUG FOUND AND FIXED 2026-09-09. cycle-window.sh instrumented
                 ;; this key from 2026-09-02 to catch focus landing in a
                 ;; DIFFERENT workspace. It caught it 12 times, and the pattern
                 ;; was unambiguous: every single one crossed to the workspace
                 ;; visible on the OTHER MONITOR, e.g.
                 ;;   before=[2|<ws-here>|Slack] after=[1|<ws-there>|Chrome]
                 ;; (real workspace names elided: this file is pushed to a
                 ;; public remote. The log has the unredacted lines.)
                 ;;
                 ;; Cause: plain `--wrap-around` leaves --boundaries at its
                 ;; default of all-monitors-outer-frame, so when the focused
                 ;; workspace runs out of windows in DFS order the wrap crosses
                 ;; the monitor boundary instead of returning to this
                 ;; workspace's first window. Every anomaly was a workspace
                 ;; holding one or two windows.
                 ;;
                 ;; THE OBSERVATION ABOVE IS SOLID; THAT STATED CAUSE IS NOT.
                 ;; Corrected 2026-09-11. The AeroSpace binary contains the
                 ;; string "(dfs-next|dfs-prev) only supports --boundaries
                 ;; workspace", so --boundaries CANNOT have defaulted to
                 ;; all-monitors-outer-frame on a dfs-next call -- that value
                 ;; is rejected for this subcommand. `--wrap-around` is its own
                 ;; flag, and the likelier mechanism is that it selects a
                 ;; wrap-across-all-monitors ACTION rather than changing
                 ;; --boundaries. NOT PROVEN, deliberately left as a question:
                 ;; the 12 logged crossings are real and the fix below is
                 ;; verified in use, so only the explanation is in doubt.
                 ;; Recorded because the wrong cause would send the next reader
                 ;; hunting a --boundaries default that does not apply here.
                 ;;
                 ;; The directional default IS `workspace`, separately: adding
                 ;; --boundaries all-monitors-outer-frame to ctrl-j/k is what
                 ;; made them reach another monitor's workspace at all.
                 ;;
                 ;; So this is NOT `focus dfs-next --wrap-around`, which is what
                 ;; cycle-window.sh's own comment said to revert to -- that is
                 ;; the buggy form. Bounding to `workspace` with
                 ;; wrap-around-the-workspace is what --wrap-around was always
                 ;; meant to express here, and it matches the deliberate
                 ;; boundary handling on j/k below.
                 [:tab [:aerospace "focus --boundaries workspace --boundaries-action wrap-around-the-workspace dfs-next"]]

                 ;; j/k cross the monitor boundary; h/l deliberately do not.
                 ;; The monitors are stacked vertically (1 = LG HDR WQHD above
                 ;; 2 = Built-in Retina), so only up/down ever needs to leave
                 ;; the workspace. Putting the flag on h/l too would let a
                 ;; horizontal press jump monitors anywhere the frames overlap
                 ;; sideways -- a surprise that is hard to attribute later.
                 ;;
                 ;; The action is `stop`, not `wrap-around-all-monitors`:
                 ;; pressing j at the bottom of monitor 2 should do nothing,
                 ;; not teleport to the top of monitor 1.
                 [:h [:aerospace "focus left"]]
                 [:j [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop down"]]
                 [:k [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop up"]]
                 [:l [:aerospace "focus right"]]

                 ;; The arrows are ALIASES for hjkl above, added 2026-09-11, and
                 ;; they repeat the same deliberate asymmetry: left/right take
                 ;; AeroSpace's default boundaries, up/down cross the monitor
                 ;; boundary with `stop`. Copied rather than factored out
                 ;; because goku's :rules take literal vectors -- if these ever
                 ;; drift from hjkl, that is a bug, not a preference.
                 ;;
                 ;; Arrows are bound HERE and not under ctrl: macOS holds
                 ;; ctrl-left and ctrl-right for Spaces switching
                 ;; (symbolichotkeys 79 and 81, both enabled=1 on this machine,
                 ;; plus 80/82 for the shift variants). ctrl-hjkl is free
                 ;; because no system chord wants it; ctrl-arrows are not.
                 [:left_arrow  [:aerospace "focus left"]]
                 [:down_arrow  [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop down"]]
                 [:up_arrow    [:aerospace "focus --boundaries all-monitors-outer-frame --boundaries-action stop up"]]
                 [:right_arrow [:aerospace "focus right"]]

                 [:hyphen [:aerospace "resize smart -200"]]
                 [:equal_sign [:aerospace "resize smart +200"]]

                 ;; AeroSpace - window state
                 [:f [:aerospace "fullscreen"]]
                 [:z [:aerospace "layout floating tiling"]]
                 [:r [:aerospace "flatten-workspace-tree"]] ;; reset the layout tree

                 ;; AeroSpace - layout
                 [:comma [:run "/Users/petermariani/.config/aerospace/set-layout.sh accordion"]]
                 [:period [:run "/Users/petermariani/.config/aerospace/set-layout.sh tiles"]]

                 ;; AeroSpace - monitor
                 [:grave_accent_and_tilde [:aerospace "move-workspace-to-monitor --wrap-around next"]]

                 ;; AeroSpace - new intance
                 ;; Ghostty moved off shift-T 2026-09-01 to free that key for
                 ;; the coming tab picker. space-enter reads well for "open a
                 ;; terminal here" and was unbound.
                 ;; The FILES picker, scoped to the focused workspace's root.
                 ;; `fd` respects .gitignore, so a project root is ~89 records
                 ;; and a client root ~2,652 rather than 63,346. Selecting a
                 ;; file hands it to macOS `open`, which does whatever that
                 ;; file type's own default handler does.
                 ;;
                 ;; A rootless workspace correctly gets "nowhere to look":
                 ;; unlike `terminal`, a files picker genuinely needs a root.
                 ;;
                 ;; `:run paneld toggle`, NOT a chord paneld registers. The two
                 ;; workspace pickers are plain chords (cmd-esc,
                 ;; shift-cmd-esc) so Carbon gets them directly, but this one
                 ;; is a space-mode entry -- and a layer cannot hand Carbon a
                 ;; chord it did not itself receive, so it drives paneld over
                 ;; its control socket instead. Costs a shell round trip on a
                 ;; key pressed far less often than ctrl-space was.
                 [:!Sf [:run "/Users/petermariani/Applications/paneld.app/Contents/MacOS/paneld toggle files"]]

                 ;; The CONFIG files picker -- ~/.config, fixed scope, from
                 ;; wherever you are. Separate from space-shift-f because that
                 ;; one is scoped to the focused workspace, so reaching
                 ;; contexts.toml through it means leaving what you were doing,
                 ;; landing on whichever monitor the workspace gets, and coming
                 ;; back. This needs no workspace switch at all.
                 [:!Sc [:run "/Users/petermariani/Applications/paneld.app/Contents/MacOS/paneld toggle config-files"]]

                 [:!Sb [:run "/Users/petermariani/.config/aerospace/new-chrome.sh"]]
                 [:return_or_enter [:run "/Users/petermariani/.config/aerospace/new-ghostty.sh"]]
                 ;; New Finder WINDOW. Deliberately not modelled on Finder's
                 ;; own ⇧⌘N, which is New Folder and writes to disk; the script
                 ;; asks for a window. Plain space-n, not space-shift-n: `:n`
                 ;; is unused in this layer (the only other `[:n ...]` is in
                 ;; chrome-mode, a different layer).
                 [:n [:run "/Users/petermariani/.config/aerospace/new-finder.sh"]]

                 ;; space-shift-P was `context pin --add`, freed when a
                 ;; context's Chrome state became RECORDED on leaving rather
                 ;; than declared. It now shows the terminal context picker.
                 ;;
                 ;; It sends hyper-P, which is the PRIVATE global hotkey of the
                 ;; isolated Ghostty instance configured by
                 ;; ~/.config/context/picker.ghostty. Deliberately not hyper-T,
                 ;; which is the user's own quick-terminal dropdown (space-t),
                 ;; and not plain space-p, which is `workspace personal`.
                 ;;
                 ;; Karabiner drives this, not Hammerspoon, so the picker's
                 ;; driver is never also its observer -- the contention that
                 ;; made two earlier latency harnesses unusable.
                 ;; [:!Sp [:!!p]] -- retired 2026-09-05 with the Ghostty
                 ;; picker instance that owned hyper-P. paneld answers
                 ;; ctrl-space directly, which is one chord and no layer.

                 ]

         }

        {
         :des "cmd-space-mode"
         :rules [
                 :cmd-space-mode

                 [:##w [:aerospace "move-node-to-workspace work"]]
                 [:##a [:aerospace "move-node-to-workspace ai"]]
                 [:##b [:aerospace "move-node-to-workspace browser"]]
                 [:##p [:aerospace "move-node-to-workspace personal"]]

                 ;; 1-9 unbound alongside space-mode. Sending a window to a
                 ;; project context has no binding for now; a move-mode picker
                 ;; is the intended home for it if the need proves real.

                 [:##h [:aerospace "move left"]]
                 [:##j [:aerospace "move down"]]
                 [:##k [:aerospace "move up"]]
                 [:##l [:aerospace "move right"]]

                 ]
         }

        {
         :des "chrome-mode"
         :rules [
                 :a-mode
                 [:m "open -a arc-alert.sh.app --args '(function () { alert(\"hello\"); }())'"]
                 [:n "open -a arc-focus-tab.sh.app --args 'Gmail'"]
                 [:l "pbpaste | tr '[:upper:]' '[:lower:]' | pbcopy"]
                 ]
         }

        { 
         :des "d-mode"
         :rules [
                 :d-mode
                 [:m :1]
                 [:comma, :2]
                 [:period, :3]
                 [:j :4]
                 [:k :5]
                 [:l :6]
                 [:u :7]
                 [:i :8]
                 [:o :9]
                 [:right_command :0]
                 [:spacebar :0]
                 ]
         }

        {
         :des "s-mode"
         :rules [
                 :s-mode
                 [:##u :!S9]
                 [:##i :!S0]
                 [:##o :!S1]

                 [:##j :!Sopen_bracket]
                 [:##k :!Sclose_bracket]
                 [:##l :!Sslash]

                 [:##m :open_bracket]
                 [:##comma :close_bracket]
                 [:##period :!S4]

                 ; [:j :!Sopen_bracket]
                 ; [:k :!Sclose_bracket]
                 ; [:h :open_bracket]
                 ; [:l :close_bracket]
                 ; [:u :!S9]
                 ; [:i :!S0]
                 ]
         }

        {
         :des "vim-mode"
         :rules [
                 :v-mode
                 [:h :left_arrow]
                 [:j :down_arrow]
                 [:k :up_arrow]
                 [:l :right_arrow]
                 ]
         }

        {
         ;; hjkl to match vim-mode above and the ctrl-hjkl pane navigation, so
         ;; the finger positions are already trained. vim-mode sends ARROWS;
         ;; this sends WHEEL events, which is why both can own hjkl.
         ;;
         ;; `:mkey` is goku's shorthand for Karabiner's `mouse_key`, and the
         ;; FIELD names are goku's own, not Karabiner's: `:vwheel` and
         ;; `:hwheel`, not `:vertical_wheel` / `:horizontal_wheel`. Writing
         ;; Karabiner's names fails the build with "invalid mouse key keyword"
         ;; -- loudly, and without overwriting karabiner.json, so a wrong
         ;; keyword here cannot reach the keyboard. The full set is
         ;; `:x :y :vwheel :hwheel :speed`.
         ;;
         ;; The sign convention was NOT derived -- it is a guess, and macOS
         ;; natural scrolling flips the felt direction on top of it. If a
         ;; direction is inverted, negate that pair rather than swapping keys.
         ;;
         ;; 64 is a starting rate, not a measured one.
         :des "f-mode: scrolling"
         :rules [
                 :f-mode
                 [:j {:mkey {:vwheel -64}}]
                 [:k {:mkey {:vwheel 64}}]
                 [:h {:mkey {:hwheel 64}}]
                 [:l {:mkey {:hwheel -64}}]
                 ]
         }

        ]
 }


; TOs
;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; P  | caps_lock
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any

; RULES
;; [<from> <to>] or
;; [<from> <to> <conditions>] or
;; [<from> <to> <conditions> <other options>]
;; <from> can be keywords defined in froms or keycodes without `{:not-from true}`
;; <to> can be keywords defined in tos, keycodes without `{:not-to true}`, string (shell script)
;; <conditions> can be keywords defined in layers, devices, applications
;; <other options> {:other {:parameters {:to_delayed_action_delay_milliseconds 100 :basic.to_if_alone_timeout_milliseconds 500 :basic.to_if_held_down_threshold_milliseconds 250}} }

