t() {
  local level=2
  local -a paths=("$@")
  local dim=$'\e[2m'
  local reset=$'\e[0m'

  if [[ ${paths[-1]} == <-> ]]; then
    level=${paths[-1]}
    paths[-1]=()
  fi

  if [[ -t 1 ]]; then
    command tree -C -L "$level" "${paths[@]:-.}" |
      sed "s/[├└│─]/${dim}&${reset}/g"
  else
    command tree -L "$level" "${paths[@]:-.}"
  fi
}

rgr() {
  rg --files --hidden -g "$1"
}

youtube-download-transcript() {
  yt-dlp --skip-download --write-subs --write-auto-subs --sub-lang en --sub-format vtt --output "$2.transcript.%(ext)s" $1
  sed -i '' -e "1,4d" -e "/^$/d" -e "/^[0-9]\{2\}.*/d" -e "s/\(&nbsp;\)\{1,\}$//" "$2.transcript.en.vtt"
  # on mac you need '' after -i
}

yadm-lazygit() {
  pushd "$HOME"
  yadm enter lazygit
  popd
}

mkdircd() { \mkdir -p -- "$1" && \cd -P -- "$1"; }

ff() {
  local files
  local query="$*"
  files=$(
    fd -t f -H -i |
      fzf --multi \
        --height=60% \
        --layout=reverse \
        --border=rounded \
        --border-label='Find Files | nvim' \
        --border-label-pos=2 \
        --preview 'bat -pp --color=always --style=plain --line-range=:500 {}' \
        --preview-window=right:45% \
        --info=inline-right \
        --prompt='❯ ' \
        --color='pointer:green' \
        --query="$query"
  ) || return
  [[ -n "$files" ]] && nvim -O ${(f)files}
}

fg() {
  local files
  local query="$*"
  files=$(
    printf '' |
      fzf --multi \
        --disabled \
        --height=60% \
        --layout=reverse \
        --border=rounded \
        --border-label='Live Grep in Files | nvim' \
        --border-label-pos=2 \
        --preview 'bat -pp --color=always --style=plain --line-range=:500 {}' \
        --preview-window=right:45% \
        --info=inline-right \
        --prompt='❯ ' \
        --color='pointer:green' \
        --query="$query" \
        --bind 'start:reload:if [[ -n {q} ]]; then rg -l -i --hidden --glob "!.git" -- {q} 2>/dev/null || true; fi' \
        --bind 'change:reload:if [[ -n {q} ]]; then rg -l -i --hidden --glob "!.git" -- {q} 2>/dev/null || true; fi'
  ) || return
  [[ -n "$files" ]] && nvim -O ${(f)files}
}
