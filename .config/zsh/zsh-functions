function rgfzf {
 command rg --color=always --line-number --no-heading --smart-case -g '!Library' -g '!site-packages' -g'!raycast' "${*:-}" \
     | command fzf -d':' --ansi --preview "command bat -p --color=always {1} --highlight-line {2}" --preview-window ~8,+{2}-5 \
     | awk -F':' '{print $1}'
}

function sesh-sessions() {
  {
    exec </dev/tty
    exec <&1
    local session
    session=$(sesh list -i | gum filter --limit 1 --no-sort --fuzzy --no-strip-ansi --placeholder 'Pick a sesh' --height 50 --prompt='⚡')
    zle reset-prompt > /dev/null 2>&1 || true
    [[ -z "$session" ]] && return
    sesh connect $session
  }
}

# Watch a directory for create/delete events, with optional exclusions
watch_dir() {
  if [[ -z "$1" ]]; then
    echo "Usage: watch_dir <directory> [--all|-a] [--level|-L <n>]"
    return 1
  fi

  # Directories to exclude
  local exclude_dirs=("node_modules" ".git" "tmp")

  local dir="$1"
  shift

  # Defaults
  local show_hidden=false
  local level=3

  # Parse optional flags
  while [[ $# -gt 0 ]]; do
    case $1 in
      -a|--all) show_hidden=true; shift ;;
      -L|--level) level="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; return 1 ;;
    esac
  done

  # Build fswatch exclude arguments
  local exclude_args=()
  for e in "${exclude_dirs[@]}"; do
    exclude_args+=("--exclude" "$dir/$e")
  done

  # Prepare tree options
  local tree_opts=("-L" "$level")
  $show_hidden && tree_opts+=("-a")

  # Expand directory to absolute path for display
  local abs_dir
  abs_dir=$(realpath "$dir")  # macOS/Linux; resolves ~ to full path

  # Replace $HOME with ~
  if [[ "$abs_dir" == "$HOME"* ]]; then
    abs_dir="~${abs_dir#$HOME}"
  fi

  # Initial static header
  clear
  echo "$abs_dir"

  # Save cursor position after header
  tput sc  # save cursor

  # Watch for create/delete events
  fswatch -0 -r --event Created --event Removed "${exclude_args[@]}" "$dir" | while IFS= read -r -d '' event
  do
    # Restore cursor to header-bottom and clear below
    tput rc    # restore cursor
    tput ed    # clear to end of screen

    # Print tree
    tree "${tree_opts[@]}" "$dir"

    # Move cursor back to below header for next update
    tput rc
  done
}


# --- Bitwarden session management ---
#
# Shares a session token across all shells/panes via a file (+ tmux global env).
# The `bw()` wrapper auto-refreshes when the session expires — prompts for your
# master password once per session lifetime, then routes transparently.
#
# Session TTL defaults to 12 hours. Set BW_SESSION_TTL to change (in seconds).

[[ -d "$HOME/.config/bw" ]] || mkdir -p "$HOME/.config/bw" 2>/dev/null

export BW_SESSION_FILE="$HOME/.config/bw/session"
: ${BW_SESSION_TTL:=43200}   # 12 hours (in seconds)

# --- Shell-start: load any existing session from file or tmux global env ---
_bw_session_age() {
    [[ -f "$BW_SESSION_FILE" ]] || return 1
    local saved_ts=$(tail -1 "$BW_SESSION_FILE" 2>/dev/null)
    [[ -n "$saved_ts" ]] && echo $(( $(date +%s) - saved_ts )) || return 1
}

if [[ -z "$BW_SESSION" ]]; then
    # Try the shared file first
    _bw_age=$(_bw_session_age)
    if [[ -n "$_bw_age" ]] && [[ "$_bw_age" -lt "$BW_SESSION_TTL" ]]; then
        export BW_SESSION=$(head -1 "$BW_SESSION_FILE")
    fi
    unset _bw_age

    # Fall back to tmux global env (which may be fresher)
    if [[ -z "$BW_SESSION" ]] && [[ -n "$TMUX" ]]; then
        _bw_tmux=$(tmux show-environment -g BW_SESSION 2>/dev/null | cut -d= -f2)
        if [[ -n "$_bw_tmux" ]] && BW_SESSION="$_bw_tmux" command bw unlock --check &>/dev/null; then
            export BW_SESSION="$_bw_tmux"
            # Sync back to file for panes outside tmux
            echo "$_bw_tmux" > "$BW_SESSION_FILE"
            date +%s >> "$BW_SESSION_FILE"
        fi
        unset _bw_tmux
    fi
fi

# --- bw wrapper — transparent session management ---
bw() {
    # Commands that manage sessions directly — pass through unchanged
    case "$1" in
        serve|login|logout|lock|config|--version|-h|--help)
            command bw "$@"
            return $?
            ;;
    esac

    # Validate current session; refresh if expired or missing
    if ! command bw unlock --check &>/dev/null; then
        # Try the shared file (another pane may have refreshed it)
        local age=$(_bw_session_age)
        if [[ -n "$age" ]] && [[ "$age" -lt "$BW_SESSION_TTL" ]]; then
            export BW_SESSION=$(head -1 "$BW_SESSION_FILE")
        fi

        # Try tmux global env (may have been set by another pane)
        if ! command bw unlock --check &>/dev/null && [[ -n "$TMUX" ]]; then
            local existing=$(tmux show-environment -g BW_SESSION 2>/dev/null | cut -d= -f2)
            if [[ -n "$existing" ]] && BW_SESSION="$existing" command bw unlock --check &>/dev/null; then
                export BW_SESSION="$existing"
            fi
        fi

        # Still no valid session — prompt once
        if ! command bw unlock --check &>/dev/null; then
            echo "Unlocking Bitwarden (enter master password)..." >&2
            local new_session=$(command bw unlock --raw)
            if [[ -z "$new_session" ]]; then
                echo "Bitwarden unlock failed." >&2
                return 1
            fi
            export BW_SESSION="$new_session"
            echo "$new_session" > "$BW_SESSION_FILE"
            date +%s >> "$BW_SESSION_FILE"
            [[ -n "$TMUX" ]] && tmux set-environment -g BW_SESSION "$new_session"
        fi
    fi

    command bw "$@"
}

